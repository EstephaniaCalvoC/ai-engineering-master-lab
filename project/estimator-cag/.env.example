# Copy this file to .env and fill in the values. Never commit .env.

# Runtime environment: development | production
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Main LLM provider: anthropic | openai
MAIN_LLM_PROVIDER=anthropic

# Main model ID for the selected provider, e.g. claude-sonnet-5-5 (Anthropic) or gpt-4o (OpenAI)
MAIN_LLM_MODEL=claude-sonnet-5-5

# Fallback LLM provider, used if the main provider fails: anthropic | openai. Leave empty to disable.
FALLBACK_LLM_PROVIDER=openai

# Fallback model ID for the fallback provider. Required if FALLBACK_LLM_PROVIDER is set.
FALLBACK_LLM_MODEL=gpt-4o

# Name of the env var that holds the main provider's API key (the name, not the key itself)
MAIN_PROVIDER_API_KEY=ANTHROPIC_API_KEY

# Name of the env var that holds the fallback provider's API key. Required if FALLBACK_LLM_PROVIDER is set.
FALLBACK_PROVIDER_API_KEY=OPENAI_API_KEY

# API keys, referenced by the names above. Set the key for each provider you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Transcription length limits, in characters. The minimum must not exceed the maximum.
MIN_TRANSCRIPTION_LENGTH=100
MAX_TRANSCRIPTION_LENGTH=20000

# Maximum output tokens per LLM reply. Must not exceed 16000 (some OpenAI models reject larger values).
MAX_OUTPUT_TOKENS=16000

# Automatic SDK retries on transient provider errors (429, 5xx, timeouts). Set to 0 to disable.
LLM_MAX_RETRIES=2

# Server (optional)
HOST=127.0.0.1
PORT=8001

# Arize AX tracing (optional; disabled when ARIZE_SPACE_ID or ARIZE_API_KEY is empty)
TRACING_ENABLED=true
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=estimator-cag
ARIZE_COLLECTOR_ENDPOINT=https://otlp.arize.com/v1

{
  "version": 1,
  "hooks": {
    "preToolUse": [
      { "command": "bash .agents/hooks/block-env.sh cursor", "failClosed": true }
    ],
    "beforeReadFile": [
      { "command": "bash .agents/hooks/block-env.sh cursor", "failClosed": true }
    ],
    "beforeShellExecution": [
      { "command": "bash .agents/hooks/block-env.sh cursor", "failClosed": true }
    ]
  }
}

{
  "context": {
    "fileName": ["AGENTS.md", "GEMINI.md"]
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "block-env",
            "type": "command",
            "command": "bash \"$GEMINI_PROJECT_DIR/.agents/hooks/block-env.sh\" || exit 2"
          }
        ]
      }
    ]
  }
}
